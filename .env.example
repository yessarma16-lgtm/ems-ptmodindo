# The application uses Supabase Postgres by default in both development and production.
# Point each deployment to its own Supabase project; never share DEV and PROD values.
DATABASE_PROVIDER=postgres

# Local direct PostgreSQL (set this for local development; do not commit the password).
# When DATABASE_URL is set, the app uses direct PostgreSQL and ignores Supabase REST.
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres

# Supabase project REST API (server-side service role key only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Used only by the schema initialization CLI (not by request-time application code)
SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/postgres

SESSION_SECRET=<long-random-secret>

# Used by the "Analyze with AI" button on MPP Attendance Calculation to summarize crosscheck results.
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-5.6-luna

# Legacy migration source. Leave unset after migration is validated.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
